MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/game_auth?retryWrites=true&w=majority
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
JWT_SECRET=replace-with-at-least-32-random-characters
PUBLIC_URL=https://your-auth-server.onrender.com
ALLOWED_ORIGIN=*

# Monster Merge PayU test checkout. Keep secrets in Render, never in Unity.
PAYMENTS_ENABLED=false
PAYMENT_MODE=test
ALLOW_LIVE_PAYMENTS=false
PAYU_KEY=
PAYU_SALT=
# Defaults to PUBLIC_URL; optional override must be an HTTPS origin.
# PAYU_PUBLIC_URL=https://auth-server-2bis.onrender.com

# Same MongoDB URI as CandyCraze; separate game database.
MONSTER_MONGODB_DATABASE=monstermerge
